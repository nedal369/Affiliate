# ══════════════════════════════════════════════════════════
# نظام أتمتة روابط الإحالة — متغيرات البيئة
# انسخ هذا الملف إلى .env وعدّل القيم
# ══════════════════════════════════════════════════════════

# مفتاح التشفير (يُنشأ تلقائياً عند أول تشغيل)
# لا تشاركه مع أحد ولا تضعه في Git
ENCRYPTION_KEY=

# بيئة التشغيل
ENVIRONMENT=production

# رقم المنفذ (Render يحدده تلقائياً)
PORT=8000

# ══════════════════════════════════════════════════════════
# ملاحظة: جميع مفاتيح API تُخزَّن في قاعدة البيانات مشفّرة
# وتُدار عبر صفحة "مفاتيح API" في لوحة التحكم
# لا تضع مفاتيح API هنا
# ══════════════════════════════════════════════════════════
